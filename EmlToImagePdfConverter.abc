package au.com.jarfusion.imsdocumentadapter.document;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.graphics.image.LosslessFactory;
import org.apache.pdfbox.pdmodel.graphics.image.PDImageXObject;
import org.apache.pdfbox.rendering.ImageType;
import org.apache.pdfbox.rendering.PDFRenderer;

import java.awt.image.BufferedImage;
import java.io.ByteArrayOutputStream;

/*
    Converts an EML email into a PDF where every page is stored as an image
    (no selectable text). The email is first laid out by EmlToPdfConverter,
    then each page is rendered to an image and placed on a page of the same size.
 */
public final class EmlToImagePdfConverter {

    private static final float DPI = 150;

    private EmlToImagePdfConverter() {
    }

    public static byte[] convert(byte[] eml) throws Exception {
        byte[] textPdf = EmlToPdfConverter.convert(eml);
        try (PDDocument source = PDDocument.load(textPdf);
             PDDocument target = new PDDocument()) {
            PDFRenderer renderer = new PDFRenderer(source);
            for (int i = 0; i < source.getNumberOfPages(); i++) {
                PDRectangle size = source.getPage(i).getMediaBox();
                BufferedImage image = renderer.renderImageWithDPI(i, DPI, ImageType.RGB);
                PDPage page = new PDPage(size);
                target.addPage(page);
                PDImageXObject pageImage = LosslessFactory.createFromImage(target, image);
                try (PDPageContentStream content = new PDPageContentStream(target, page)) {
                    content.drawImage(pageImage, 0, 0, size.getWidth(), size.getHeight());
                }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            target.save(out);
            return out.toByteArray();
        }
    }
}
