  <data name="DbSelectCommand7.CommandText" xml:space="preserve">
    <value>SELECT     NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.VehiclePolicyLimitsID AS VehicleID, 
                      NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.UnitNumber AS VehicleNumber, NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.Make, 
                      NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.Model, NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.ModelYear AS Year, 
                      NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.VIN, MAX(tblVinLog.DecodeDate) AS [Last Scan], tblQuotes.OriginalQuoteGUID, tblQuotes.ControlNo, 
                      tblQuotes.PolicyNumber, tblQuotes.InsuredPolicyName
FROM         NetRate_Quote_Insur_Quote INNER JOIN
                      tblQuotes ON NetRate_Quote_Insur_Quote.QuoteID = tblQuotes.NetRate_QuoteID INNER JOIN
                      NetRate_Quote_Insur_Quote_Locat ON NetRate_Quote_Insur_Quote.QuoteID = NetRate_Quote_Insur_Quote_Locat.QuoteID INNER JOIN
                      NetRate_Quote_Insur_Quote_Locat_Busin ON 
                      NetRate_Quote_Insur_Quote_Locat.LocationID = NetRate_Quote_Insur_Quote_Locat_Busin.LocationID INNER JOIN
                      NetRate_Quote_Insur_Quote_Locat_Busin_Vehic ON 
                      NetRate_Quote_Insur_Quote_Locat_Busin.BusinessAutoID = NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.BusinessAutoID LEFT OUTER JOIN
                      tblVinLog ON NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.VIN = tblVinLog.VinNumber
WHERE     (tblQuotes.QuoteID = @QuoteID) 
GROUP BY NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.VehiclePolicyLimitsID, NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.UnitNumber, 
                      NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.Make, NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.Model, 
                      NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.ModelYear, NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.VIN, tblQuotes.OriginalQuoteGUID, 
                      tblQuotes.ControlNo, tblQuotes.PolicyNumber, tblQuotes.InsuredPolicyName
HAVING      (NetRate_Quote_Insur_Quote_Locat_Busin_Vehic.UnitNumber IS NOT NULL)
ORDER BY tblQuotes.OriginalQuoteGuid </value>
  </data>
