<Window x:Class="MGASystems.IMS.Excel.Views.ExternalExcelSaveOptions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mgaWpf="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
        xmlns:mgaValueConverters="clr-namespace:Mga.Wpf.Ims.ValueConverters;assembly=Mga.Wpf.Ims"
        Loaded="Window_Loaded" SizeToContent="WidthAndHeight" Width="430" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
      <mgaValueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <mgaValueConverters:BooleanNotConverter x:Key="BooleanNotConverter"/>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Style>
    <Style TargetType="{x:Type Window}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ExcelFile.IsWorking}" Value="true">
          <Setter Property="UIElement.IsEnabled" Value="false"/>
        </DataTrigger>
      </Style.Triggers>
      <Setter Property="UIElement.IsEnabled" Value="true"/>
    </Style>
  </FrameworkElement.Style>
  <Border BorderBrush="#32465A" BorderThickness="1">
    <Grid>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ExpanderResources.xaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.RowDefinitions>
        <RowDefinition MinHeight="80" Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="auto"/>
          <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Label Style="{StaticResource headerStyle1}">
          <StackPanel Orientation="Horizontal">
            <Image Source="/MGASystems.IMS.Excel;component/Images/excel258.png" Stretch="None"/>
            <TextBlock Text="Would you like to save your changes to the IMS?" Margin="5,0,0,0"/>
          </StackPanel>
        </Label>
        <Label Grid.Row="1" Content="{Binding Path=ExcelFile.Status, Mode=OneWay}"/>
      </Grid>
      <StackPanel Orientation="Vertical" Grid.Row="1"
                  Visibility="{Binding ExcelFile.HasUpdateErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Vertical">
          <Label Content="Data mapping errors have been detected that prevented us from rating."/>
          <CheckBox Name="shouldIgnoreMappingErrors" Margin="10,2,2,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Check here to ignore any bad "/>
              <TextBlock ToolTip="Click to export these errors to an Excel file.">
                <Hyperlink Click="Hyperlink_Click">mappings</Hyperlink>
              </TextBlock>
              <TextBlock Text=" and rate what we can anyway."/>
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </StackPanel>
      <ProgressBar Grid.Row="2" Margin="10,2,10,2" Height="20" Maximum="100" Minimum="0"
                   Value="{Binding Path=ExcelFile.PercentDownloaded, Mode=OneWay}"
                   Visibility="{Binding ExcelFile.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <Expander Style="{StaticResource ExpanderWithoutToggleButton}" Grid.Row="3"
                IsExpanded="{Binding ElementName=mainExpander, Path=IsExpanded}">
        <StackPanel Margin="12,2,2,2">
          <ListBox Name="errorList" MaxHeight="200"
                   Visibility="{Binding ExcelFile.HasUpdateErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                   ItemsSource="{Binding ExcelFile.UpdateErrors}"/>
          <CheckBox Name="shouldUpdateQuote" IsChecked="True" Content="Update the quote."
                    IsEnabled="{Binding ExcelFile.HasUpdateErrors, Converter={StaticResource BooleanNotConverter}}"/>
          <CheckBox Name="shouldCopyToDocHandler" Content="Save a copy of this file to the document handler."
                    IsEnabled="{Binding ExcelFile.HasUpdateErrors, Converter={StaticResource BooleanNotConverter}}"/>
        </StackPanel>
      </Expander>
      <Border BorderThickness="0,2,0,0" BorderBrush="#DFDFDF" Grid.Row="4">
        <Grid Background="#F0F0F0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
          </Grid.ColumnDefinitions>
          <FrameworkElement.Resources>
            <Style x:Key="expanderStyle" TargetType="{x:Type Expander}">
              <Setter Property="HeaderedContentControl.Header" Value="More Options"/>
              <Style.Triggers>
                <Trigger Property="Expander.IsExpanded" Value="true">
                  <Setter Property="HeaderedContentControl.Header" Value="Less Options"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Resources>
          <Expander Name="mainExpander" Margin="10,0,0,10" Style="{StaticResource expanderStyle}"/>
          <Grid Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
              <FrameworkElement.Resources>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="FrameworkElement.Margin" Value="2,10,2,10"/>
                  <Setter Property="FrameworkElement.MinWidth" Value="80"/>
                </Style>
                <Style x:Key="saveStyle" TargetType="{x:Type Button}">
                  <Setter Property="FrameworkElement.Margin" Value="2,10,2,10"/>
                  <Setter Property="FrameworkElement.MinWidth" Value="80"/>
                  <Setter Property="UIElement.IsEnabled" Value="true"/>
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=shouldUpdateQuote, Path=IsChecked}" Value="False"/>
                        <Condition Binding="{Binding ElementName=shouldCopyToDocHandler, Path=IsChecked}" Value="False"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=shouldIgnoreMappingErrors, Path=IsChecked}" Value="False"/>
                        <Condition Binding="{Binding ExcelFile.HasUpdateErrors}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Resources>
              <Button Click="Save_Click" Style="{StaticResource saveStyle}" Content="Save" IsDefault="true"/>
              <Button Click="SaveWithoutExit_Click" Content="Don't Save"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>