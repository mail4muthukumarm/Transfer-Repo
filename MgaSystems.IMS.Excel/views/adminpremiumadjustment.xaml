<local:AdminPremiumAdjustment x:Class="MgaSystems.IMS.Excel.Views.AdminPremiumAdjustment"
                              xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                              xmlns:baseWpfControls="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                              xmlns:baseWpfCommands="clr-namespace:Mga.Wpf.Ims.Commands;assembly=Mga.Wpf.Ims"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:data="clr-namespace:MgaSystems.IMS.Excel.Data.PremiumAdmin"
                              xmlns:local="clr-namespace:MgaSystems.IMS.Excel.Views"
                              ResizeMode="CanResizeWithGrip" Title="Administrative Premium Adjustment"
                              WindowStartupLocation="CenterScreen" PromptOnCloseIfDataContextHasChanges="true"
                              TransactionLogFilter="A4B59396-E66A-4822-8BFC-B59A122BC36F" FrameworkElement.Width="700"
                              FrameworkElement.Height="500">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/SplitButtonResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/DataGridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource gridViewColumnHeaderStyle}"/>
      <BooleanToVisibilityConverter x:Key="visibilityConverter"/>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel LastChildFill="true">
    <ToolBarTray DockPanel.Dock="Top">
      <FrameworkElement.Resources>
        <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource toolBarTrayStyle}"/>
        <Style TargetType="{x:Type Image}" BasedOn="{StaticResource verticalToolbarImageStyle}"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource toolbarButtonStyle}"/>
        <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource toolbarStackPanelStyle}"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource verticalToolbarTextBlockStyle}"/>
        <Style TargetType="{x:Type ToolBar}" BasedOn="{StaticResource toolBarStyle}"/>
        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource verticalToolbarAccessTextStyle}"/>
      </FrameworkElement.Resources>
      <ToolBar>
        <Button ToolTip="Save" Command="{Binding Source={x:Static baseWpfCommands:DatabaseCommands.SubmitChanges}}"
                CommandParameter="{Binding}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/saveHS.png"/>
            <AccessText Text="_Save"/>
          </StackPanel>
        </Button>
        <Separator/>
        <baseWpfControls:UndoButton ChangeManager="{Binding Path=ChangeManager}"/>
        <baseWpfControls:RedoButton ChangeManager="{Binding Path=ChangeManager}"/>
        <Separator/>
        <Button ToolTip="Re-apply prior premium changes in order, this is useful if a rater is reinvoked after manual changes are applied"
                Command="{Binding ReapplyPriorChanges, Mode=OneWay}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/database_refresh.png"/>
            <AccessText Text="Reapply Prior Changes"/>
          </StackPanel>
        </Button>
        <Separator/>
        <Button ToolTip="Open SQL Management Studio" Command="{Binding LaunchSSMSCommand, Mode=OneWay}"
                Visibility="{Binding CanCopySSMSPasswordToClipboard, Converter={StaticResource visibilityConverter}}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/database_gear.png"/>
            <AccessText Text="Open SQL Management Studio"/>
          </StackPanel>
        </Button>
        <Button ToolTip="Password will be in clipboard for 10 seconds"
                Command="{Binding CopySSMSPasswordToClipboardCommand, Mode=OneWay}"
                Visibility="{Binding IsAdmin, Converter={StaticResource visibilityConverter}}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/book_edit.png"/>
            <AccessText Text="Copy SQL Password"/>
          </StackPanel>
        </Button>
      </ToolBar>
    </ToolBarTray>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto"/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Reason/TFS#"/>
        <TextBox Grid.Column="1" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding OptionPremiums}" IsReadOnly="{Binding IsBound}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Line" IsReadOnly="true" Binding="{Binding LineName, Mode=OneWay}"/>
          <DataGridTextColumn Header="Charge" IsReadOnly="true" Binding="{Binding ChargeName, Mode=OneWay}"/>
          <DataGridTextColumn Width="*" Header="Premium"
                              Binding="{Binding Premium, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataGrid.Columns>
      </DataGrid>
      <Grid Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="Historical Change Log (ExcelRating__ManualPremiumChangeLog)"/>
        <DataGrid Grid.Row="1" IsReadOnly="true" DataContext="{Binding XmlLogData}"
                  ItemsSource="{Binding XPath=/PremiumChangeLogs/LogEntry}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="QuoteID" Binding="{Binding XPath=@QuoteID}"/>
            <DataGridTextColumn Header="QuoteGuid" Binding="{Binding XPath=@QuoteGuid}"/>
            <DataGridTextColumn Header="User" Binding="{Binding XPath=@username}"/>
            <DataGridTextColumn Header="Machine" Binding="{Binding XPath=@machinename}"/>
            <DataGridTextColumn Header="Date Updated" Binding="{Binding XPath=@dateupdated}"/>
            <DataGridTextColumn Header="PremiumID" Binding="{Binding XPath=@premiumid}"/>
            <DataGridTextColumn Header="Old Value" Binding="{Binding XPath=@oldvalue}"/>
            <DataGridTextColumn Header="New Value" Binding="{Binding XPath=@newvalue}"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding XPath=@Reason}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </DockPanel>
</local:AdminPremiumAdjustment>