<ExcelDownloadingWaitWindow x:Class="MGASystems.IMS.Excel.Views.ExcelDownloadingWaitWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                            xmlns:mgaWpf="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                            Title="Downloading your Excel Rater..." FrameworkElement.Height="150" FrameworkElement.Width="386"
                            ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                            FrameworkElement.Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type mgaWpf:MgaWindow}, ResourceId=backgroundStyle}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <Label Grid.Row="1" Margin="10,10,10,5" Content="Please wait while we download your Excel Rater..."/>
    <ProgressBar Height="20" Grid.Row="2" Minimum="0" Maximum="100" Margin="10,2,10,5"
                 Value="{Binding PercentDownloaded, Mode=OneWay}"/>
    <mgaWpf:LoadingAnimation Grid.Row="0" FrameworkElement.VerticalAlignment="Center"/>
  </Grid>
</ExcelDownloadingWaitWindow>