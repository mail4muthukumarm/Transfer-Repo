<Window x:Class="MGASystems.IMS.Excel.Rating.ExcelFilePicker.ExcelFileList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mgaWpfValueConverters="clr-namespace:Mga.Wpf.Ims.ValueConverters;assembly=Mga.Wpf.Ims"
        Title="Excel Files" Height="300" Width="450" WindowStartupLocation="CenterScreen">
  <Grid>
    <FrameworkElement.Resources>
      <mgaWpfValueConverters:FileNameToTypeImageConverter x:Key="FileNameToTypeImageConverter"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="75"/>
        <Setter Property="FrameworkElement.Margin" Value="5"/>
      </Style>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <ListView Name="fileList" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding ExcelFiles}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="File Name">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Image Height="16" Width="16" Margin="0,0,5,0"
                         Source="{Binding FileName, ConverterParameter=small, Converter={StaticResource FileNameToTypeImageConverter}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding FileName}" ToolTip="{Binding Description}"/>
                </Grid>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Date Added" DisplayMemberBinding="{Binding DateAdded}"/>
        </GridView>
      </ListView.View>
    </ListView>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Content="OK" IsDefault="true" Grid.Column="1">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ElementName=fileList, Path=SelectedIndex}" Value="-1">
                <Setter Property="UIElement.IsEnabled" Value="false"/>
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="UIElement.IsEnabled" Value="true"/>
          </Style>
        </FrameworkElement.Style>
      </Button>
      <Button Content="Cancel" IsCancel="true" Grid.Column="2"/>
    </Grid>
  </Grid>
</Window>