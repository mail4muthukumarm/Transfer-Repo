<e2Value:PropertiesViewer x:Class="MgaSystems.IMS.Policies.E2Value.PropertiesViewer"
                          xmlns:interop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                          xmlns:e2Value="clr-namespace:MgaSystems.IMS.Policies.E2Value"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          FrameworkElement.MinHeight="300" FrameworkElement.MinWidth="600"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Title="Properties Viewer"
                          FrameworkElement.DataContext="{Binding RelativeSource={RelativeSource Self}, Path=properties}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DataGridResources2.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel Name="MainPanel">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
      <Button Click="GetValues_OnClick" Content="Get Values" Margin="0,0,4,0"/>
      <Button Click="SelectAll_Click" Content="Select All" Margin="0,0,4,0"/>
      <Button Click="DeselectAll_Click" Content="Deselect All" Margin="0,0,4,0"/>
      <ProgressBar Name="progress" Width="120"/>
    </StackPanel>
    <DataGrid AutoGenerateColumns="false" ItemsSource="{Binding}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Include" Binding="{Binding Include}"/>
        <DataGridCheckBoxColumn IsReadOnly="true" Header="Errored" Binding="{Binding IsErrored}">
          <DataGridColumn.CellStyle>
            <Style TargetType="{x:Type DataGridCell}">
              <Setter Property="FrameworkElement.ToolTip" Value="{Binding ErrorMessage}"/>
            </Style>
          </DataGridColumn.CellStyle>
        </DataGridCheckBoxColumn>
        <DataGridTemplateColumn Header="Edit">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Edit" Command="{Binding Source={x:Static e2Value:E2ValueCommands.DoTheThing}}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Square Footage" Binding="{Binding InnerProperty.total_square_footage}"/>
        <DataGridTextColumn Header="Address 1" Binding="{Binding InnerProperty.address1}"/>
        <DataGridTextColumn Header="Address 2" Binding="{Binding InnerProperty.address2}"/>
        <DataGridTextColumn Header="City" Binding="{Binding InnerProperty.city}"/>
        <DataGridComboBoxColumn Header="State" ItemsSource="{Binding Source={x:Static e2Value:Property.States}}"
                                SelectedItemBinding="{Binding InnerProperty.state}"/>
        <DataGridTextColumn Header="Structure Cost Low" Binding="{Binding structure_cost_range_low}"/>
        <DataGridTextColumn Header="Structure Cost Med" Binding="{Binding structure_cost_range_med}"/>
        <DataGridTextColumn Header="Structure Cost High" Binding="{Binding structure_cost_range_high}"/>
        <DataGridTextColumn Header="ACV Low" Binding="{Binding acv_range_low}"/>
        <DataGridTextColumn Header="ACV Med" Binding="{Binding acv_range_med}"/>
        <DataGridTextColumn Header="ACV High" Binding="{Binding acv_range_high}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</e2Value:PropertiesViewer>