<e2Value:PropertyEditor x:Class="MgaSystems.IMS.Policies.E2Value.PropertyEditor"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:e2Value="clr-namespace:MgaSystems.IMS.Policies.E2Value"
                        xmlns:interop1="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                        xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
                        FrameworkElement.MinHeight="240" FrameworkElement.MinWidth="455" ResizeMode="CanResizeWithGrip"
                        Title="Property Editor"
                        FrameworkElement.DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <DockPanel>
    <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="60"
            Margin="4" Content="OK" Command="{Binding SaveCommand}" CommandParameter="{Binding editableFields}"/>
    <GroupBox Header="Address" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="4,4,2,4"
              DataContext="{Binding editableFields}">
      <StackPanel>
        <DockPanel LastChildFill="false">
          <Label Content="Address 1"/>
          <TextBox DockPanel.Dock="Right" Width="120" Text="{Binding address1}"/>
        </DockPanel>
        <DockPanel LastChildFill="false">
          <Label Content="Address 2"/>
          <TextBox DockPanel.Dock="Right" Width="120" Text="{Binding Path=address2}"/>
        </DockPanel>
        <DockPanel LastChildFill="false">
          <Label Content="City"/>
          <TextBox DockPanel.Dock="Right" Width="120" Text="{Binding Path=city}"/>
        </DockPanel>
        <DockPanel LastChildFill="false">
          <Label Content="State"/>
          <ComboBox DockPanel.Dock="Right" Width="120"
                    ItemsSource="{Binding Source={x:Static e2Value:Property.States}}"
                    SelectedItem="{Binding Path=state}"/>
        </DockPanel>
        <DockPanel LastChildFill="false">
          <Label Content="Zip Code"/>
          <TextBox DockPanel.Dock="Right" Width="120">
            <TextBox.Text>
              <Binding Path="zipcode" UpdateSourceTrigger="PropertyChanged">
                <Binding.ValidationRules>
                  <DataErrorValidationRule/>
                </Binding.ValidationRules>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </DockPanel>
      </StackPanel>
    </GroupBox>
    <GroupBox Header="Property Details" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="2,4,2,4"
              DataContext="{Binding editableFields}">
      <StackPanel>
        <DockPanel>
          <Label Content="Square Footage"/>
          <IntegerUpDown ShowButtonSpinner="false" Text="{Binding total_square_footage}"/>
        </DockPanel>
        <DockPanel>
          <Label Content="Coverage Amount"/>
          <DecimalUpDown ShowButtonSpinner="false" Text="{Binding Path=coverage_a}"/>
        </DockPanel>
        <DockPanel>
          <Label Content="Construction Quality"/>
          <ComboBox ItemsSource="{Binding Source={x:Static e2Value:Property.ConstructionQualities}}"
                    SelectedValue="{Binding Path=construction_quality}"/>
        </DockPanel>
        <DockPanel>
          <Label Content="ConstructionType"/>
          <ComboBox ItemsSource="{Binding Source={x:Static e2Value:Property.ConstructionTypes}}"
                    SelectedValue="{Binding Path=construction_type}"/>
        </DockPanel>
        <DockPanel>
          <Label Content="Exterior"/>
          <ComboBox ItemsSource="{Binding Source={x:Static e2Value:Property.Exteriors}}"
                    SelectedValue="{Binding Path=exterior}"/>
        </DockPanel>
        <DockPanel>
          <Label Content="Roof Covering"/>
          <ComboBox ItemsSource="{Binding Source={x:Static e2Value:Property.RoofCoverings}}"
                    SelectedValue="{Binding Path=roof_covering}"/>
        </DockPanel>
        <DockPanel>
          <Label Content="Business Entity Name"/>
          <TextBox Text="{Binding Path=BusinessEntityName}"/>
        </DockPanel>
      </StackPanel>
    </GroupBox>
  </DockPanel>
</e2Value:PropertyEditor>