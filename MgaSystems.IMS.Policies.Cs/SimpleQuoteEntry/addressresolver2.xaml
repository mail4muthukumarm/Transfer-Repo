<UserControl x:Class="MgaSystems.IMS.Policies.SimpleQuoteEntry.AddressResolver2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MgaSystems.IMS.Policies.SimpleQuoteEntry"
             x:Name="AddrResolver2">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
        <Setter Property="FrameworkElement.MinHeight" Value="18"/>
        <Style.Triggers>
          <Trigger Property="TextBoxBase.IsReadOnly" Value="true">
            <Setter Property="Control.Background" Value="LightGray"/>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
      <TextBlock Text="Country:"/>
      <ComboBox Name="cboCountry" DisplayMemberPath="Country" SelectedValuePath="ISOCode" MinWidth="200"
                SelectedValue="{Binding ElementName=AddrResolver2, Path=ISOCountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
      <TextBlock Text="Address:"/>
      <TextBox Name="txtAddress1"
               Text="{Binding ElementName=AddrResolver2, Path=Address1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <TextBox Name="txtAddress2" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
             Text="{Binding ElementName=AddrResolver2, Path=Address2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <StackPanel Grid.Row="3" Grid.Column="0">
      <TextBlock Text="Zip:"/>
      <TextBox Name="txtZip"
               Text="{Binding ElementName=AddrResolver2, Path=ZipCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ElementName=AddrResolver2, Path=IsInvalidZip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Value="true">
                <Setter Property="Control.Foreground" Value="Red"/>
                <Setter Property="Control.Background" Value="LightGoldenrodYellow"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBox>
    </StackPanel>
    <StackPanel Grid.Row="3" Grid.Column="1">
      <TextBlock Text="Ext:"/>
      <TextBox Name="txtZipExt"
               Text="{Binding ElementName=AddrResolver2, Path=ZipExt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Grid.Column="0">
      <TextBlock Text="City:"/>
      <TextBox Name="txtCity" IsReadOnly="true"
               Text="{Binding ElementName=AddrResolver2, Path=City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Grid.Column="1">
      <TextBlock Text="State:"/>
      <TextBox Name="txtState" IsReadOnly="true"
               Text="{Binding ElementName=AddrResolver2, Path=State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <StackPanel Grid.Row="5" Grid.Column="0">
      <TextBlock Text="County:"/>
      <TextBox Name="txtCounty" IsReadOnly="true"
               Text="{Binding ElementName=AddrResolver2, Path=County, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
  </Grid>
</UserControl>