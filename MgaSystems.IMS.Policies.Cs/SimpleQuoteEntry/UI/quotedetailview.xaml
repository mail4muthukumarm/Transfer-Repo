<UserControl x:Class="MgaSystems.IMS.Policies.SimpleQuoteEntry.UI.QuoteDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MgaSystems.IMS.Policies.SimpleQuoteEntry.UI"
             xmlns:baseWpfValueConverters="clr-namespace:Mga.Wpf.Ims.ValueConverters;assembly=Mga.Wpf.Ims">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ListViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <baseWpfValueConverters:BoolToVisibilityConverter x:Key="mgaBoolToVisibilityConverter"/>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
        <Style.Triggers>
          <Trigger Property="TextBoxBase.IsReadOnly" Value="true">
            <Setter Property="Control.Background" Value="LightGray"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="20"/>
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource standardTextForegroundColor}"/>
      </Style>
      <SolidColorBrush x:Key="SelectedBrush" Color="{DynamicResource {x:Static JetSystemColors.HighlightColorKey}}"/>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <FrameworkElement Name="intermediaryDummyElement" Visibility="Collapsed"/>
    <DataGrid Grid.Row="1" MinHeight="70" MaxHeight="110"
              ItemsSource="{Binding SimpleQuote.Quote.QuoteDetails, UpdateSourceTrigger=PropertyChanged}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Company/Line/State  " Width="Auto" IsReadOnly="true"
                            Binding="{Binding CompanyLine, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTemplateColumn Header="Company Contact  " Width="auto"
                                Visibility="{Binding DataContext.SimpleQuote.Quote.UseIntermediary, Source={x:Reference intermediaryDummyElement}, Converter={StaticResource mgaBoolToVisibilityConverter}, ConverterParameter=True-Collapsed;*-Visible}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox DisplayMemberPath="Name" SelectedValuePath="CompanyContactGuid" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding CompanyContacts, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValue="{Binding CompanyContactGuid, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Intermediary Contact  " Width="auto"
                                Visibility="{Binding DataContext.SimpleQuote.Quote.UseIntermediary, Source={x:Reference intermediaryDummyElement}, Converter={StaticResource mgaBoolToVisibilityConverter}, ConverterParameter=False-Collapsed;*-Visible}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox DisplayMemberPath="Name" SelectedValuePath="IntermediaryContactGuid" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding IntermediaryContacts, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValue="{Binding IntermediaryContactGuid, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Company  "
                            Binding="{Binding CompanyCommission, UpdateSourceTrigger=PropertyChanged, StringFormat={0:P4}}"/>
        <DataGridTextColumn Header="Producer  "
                            Binding="{Binding ProducerCommission, UpdateSourceTrigger=PropertyChanged, StringFormat={0:P4}}"/>
        <DataGridTemplateColumn Header="Program Code  " Width="auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox DisplayMemberPath="ProgCode" SelectedValuePath="ProgramID" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.SimpleQuote.Submission.QuoteEditCode.ProgramCodes}"
                        SelectedValue="{Binding ProgramCodeID, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>