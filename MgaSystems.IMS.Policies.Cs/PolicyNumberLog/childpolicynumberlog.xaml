<local:ChildPolicyNumberLog x:Class="MgaSystems.IMS.Policies.PolicyNumberLog.ChildPolicyNumberLog"
                            xmlns:interop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:dg="http://schemas.microsoft.com/wpf/2008/toolkit"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:local="clr-namespace:MgaSystems.IMS.Policies.PolicyNumberLog"
                            xmlns:dg1="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
                            FrameworkElement.Height="700" FrameworkElement.Width="820">
  <StackPanel Name="MainPanel" RenderTransformOrigin="0.835,0.492">
    <Label Content="Child Policy #s Log Entries"/>
    <DataGrid Name="dgChildPolicyNumbers" AutoGenerateColumns="false" Width="810" Height="660"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsReadOnly="false"
              CanUserResizeColumns="true" SelectionMode="Single" SelectionUnit="Cell" CanUserAddRows="false"
              CanUserSortColumns="true" Margin="0,10,0,0" ItemsSource="{Binding ChildPolicyNumberList}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="QuoteId" IsReadOnly="true" Width="85" Binding="{Binding QuoteId}"/>
        <DataGridTextColumn Header="Policy #" IsReadOnly="true" Width="110" Binding="{Binding PolicyNumber}"/>
        <DataGridTextColumn Header="Rule" IsReadOnly="true" Width="120" Binding="{Binding RuleName}"/>
        <DataGridTextColumn Header="Index" IsReadOnly="true" Width="80" Binding="{Binding RuleIndex}"/>
        <DataGridTextColumn Header="HostName" IsReadOnly="true" Width="85" Binding="{Binding HostName}"/>
        <DataGridTextColumn Header="Action" IsReadOnly="true" Width="95" Binding="{Binding Action}"/>
        <DataGridTextColumn Header="Date" IsReadOnly="true" Width="85" Binding="{Binding ActionDate}"/>
        <DataGridTextColumn Header="Company / Line" Width="220" Binding="{Binding CompanyLine}"/>
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</local:ChildPolicyNumberLog>