<local:BindingChecklistView x:Class="MgaSystems.IMS.Policies.BindingChecklist.BindingChecklistView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:local="clr-namespace:MgaSystems.IMS.Policies.BindingChecklist"
                            xmlns:baseWpfBehaviors="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                            xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                            FrameworkElement.Width="700" FrameworkElement.Height="700"
                            TransactionLogFilter="4291b5e7-2b4b-4391-b687-5925c1ffdea2">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <ToolBarTray Grid.Row="0">
      <FrameworkElement.Resources>
        <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource toolBarTrayStyle}"/>
        <Style TargetType="{x:Type Image}" BasedOn="{StaticResource verticalToolbarImageStyle}"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource toolbarButtonStyle}"/>
        <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource toolbarStackPanelStyle}"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource verticalToolbarTextBlockStyle}"/>
        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource verticalToolbarAccessTextStyle}"/>
      </FrameworkElement.Resources>
      <ToolBar Band="1">
        <Button ToolTip="Save" Command="{Binding SaveCommand}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/saveHS.png"/>
            <AccessText Text="_Save"/>
          </StackPanel>
        </Button>
        <Separator/>
        <baseWpfBehaviors:UndoButton ChangeManager="{Binding ChangeManager, Mode=OneWay}"/>
        <baseWpfBehaviors:RedoButton ChangeManager="{Binding ChangeManager, Mode=OneWay}"/>
        <Separator/>
        <Button ToolTip="Add Requirement" Command="{Binding AddCommand, Mode=OneWay}">
          <ContentControl.Content>
            <StackPanel>
              <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/add.png"/>
              <AccessText Text="Add Requirement"/>
            </StackPanel>
          </ContentControl.Content>
        </Button>
        <Button ToolTip="Remove Requirement" Command="{Binding RemoveItem, Mode=OneWay}">
          <ContentControl.Content>
            <StackPanel>
              <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/delete.png"/>
              <AccessText Text="Remove Requirement"/>
            </StackPanel>
          </ContentControl.Content>
        </Button>
      </ToolBar>
    </ToolBarTray>
    <DataGrid Grid.Row="1" AutoGenerateColumns="false" HorizontalScrollBarVisibility="Visible"
              SelectionMode="Single" CanUserAddRows="false" CanUserDeleteRows="false"
              ItemsSource="{Binding pBindingChecklistAdmin}" SelectedItem="{Binding SelectedIteminGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Requirement" Width="*" IsReadOnly="true"
                            Binding="{Binding Requirement, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTemplateColumn Header="Bind">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsBind, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Issue">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsIssue, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Quote">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsQuote, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Comment" Width="*" IsReadOnly="true"
                            Binding="{Binding Comment, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Row="2">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Name="lblRequirement" Text="Requirement:" Margin="0,15,0,0" Grid.Row="0" Grid.Column="0"/>
      <TextBox Name="txtRequirement" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2,-514,2"
               Text="{Binding SelectedIteminGrid.Requirement, UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Name="chkBind" Content="Bind" Grid.Row="1" Margin="0,15,0,0"
                IsChecked="{Binding SelectedIteminGrid.IsBind, UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Name="chkIssue" Content="Issue" Grid.Column="1" Grid.Row="1" Margin="0,15,0,0"
                IsChecked="{Binding SelectedIteminGrid.IsIssue, UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Name="chkQuote" Content="Quote" Grid.Column="2" Grid.Row="1" Margin="0,15,0,0"
                IsChecked="{Binding SelectedIteminGrid.IsQuote, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Name="lblComment" Text="Comment:" Margin="0,15,0,0" Grid.Row="3" Grid.Column="0"/>
      <TextBox Name="txtComment" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2,-514,2"
               Text="{Binding SelectedIteminGrid.Comment, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
  </Grid>
</local:BindingChecklistView>