<local:NetrateFCWListView x:Class="MgaSystems.IMS.Policies.FCWComments.NetrateFCWListView"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:local="clr-namespace:MgaSystems.IMS.Policies.FCWComments"
                          xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                          xmlns:baseWpfValueConverters="clr-namespace:Mga.Wpf.Ims.ValueConverters;assembly=Mga.Wpf.Ims"
                          xmlns:baseWpfBehaviors="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                          xmlns:baseValueConverters="clr-namespace:Mga.Wpf.Ims.ValueConverters;assembly=Mga.Wpf.Ims"
                          xmlns:wpfToolKit="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
                          x:Name="mainWindow" FrameworkElement.Height="600" FrameworkElement.Width="800"
                          Title="FCW Comments Administration" WindowStartupLocation="CenterScreen"
                          ResizeMode="CanResizeWithGrip" TransactionLogFilter="21A2A6ED-97F3-4B5E-96B2-6AF7BC792F37">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <baseValueConverters:BoolToVisibilityConverter x:Key="mgaBoolToVisibilityConverter"/>
      <baseValueConverters:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
      <baseValueConverters:BooleanNotConverter x:Key="boolNotConv"/>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
        <Style.Triggers>
          <Trigger Property="TextBoxBase.IsReadOnly" Value="true">
            <Setter Property="Control.Background" Value="LightGray"/>
          </Trigger>
        </Style.Triggers>
        <Style.Setters>
          <Setter Property="FrameworkElement.Height" Value="27"/>
          <Setter Property="FrameworkElement.Width" Value="450"/>
          <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center"/>
        </Style.Setters>
      </Style>
      <Style x:Key="SearchBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="FrameworkElement.Height" Value="20"/>
        <Setter Property="FrameworkElement.Width" Value="20"/>
      </Style>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource standardTextForegroundColor}"/>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Row="0">
        <ToolBarTray>
          <FrameworkElement.Resources>
            <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource toolBarTrayStyle}"/>
            <Style TargetType="{x:Type Image}" BasedOn="{StaticResource verticalToolbarImageStyle}"/>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource toolbarButtonStyle}"/>
            <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource toolbarStackPanelStyle}"/>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource verticalToolbarTextBlockStyle}"/>
            <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource verticalToolbarAccessTextStyle}"/>
          </FrameworkElement.Resources>
          <ToolBar Margin="10,0">
            <Button ToolTip="Save" Command="{Binding SaveCommand}">
              <StackPanel>
                <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/saveHS.png"/>
                <AccessText Text="_Save"/>
              </StackPanel>
            </Button>
            <Separator/>
            <baseWpfBehaviors:UndoButton ChangeManager="{Binding ConditionListManager.ChangeManager, Mode=OneWay}"/>
            <Separator/>
            <baseWpfBehaviors:RedoButton ChangeManager="{Binding ConditionListManager.ChangeManager, Mode=OneWay}"/>
          </ToolBar>
        </ToolBarTray>
      </Grid>
      <Grid Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <wpfToolKit:WatermarkTextBox FrameworkElement.Height="27" FrameworkElement.Margin="10,10" Watermark="Filter Condition"
                                     TextBox.Text="{Binding FilterCondition, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGrid Grid.Row="1" SelectionMode="Single" AutoGenerateColumns="false" CanUserAddRows="false"
                  CanUserDeleteRows="false" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="false"
                  ItemsSource="{Binding ConditionCVS.View, UpdateSourceTrigger=PropertyChanged}"
                  SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Width="Auto" IsReadOnly="true" Binding="{Binding ID}"/>
            <DataGridTextColumn Header="FCW Condition Name " Width="3*" IsReadOnly="true" Binding="{Binding FCWConditionName}"/>
            <DataGridTextColumn Header="Rater" Width="1*" IsReadOnly="true" Binding="{Binding RatingType}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
      <GroupBox Grid.Row="2" Header="Condition Properties" Margin="10,10">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="FCW Condition Name:" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <TextBox Grid.Column="1" MaxLength="50" IsReadOnly="true"
                   Text="{Binding SelectedItem.FCWConditionName, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="1" Text="Comments:" HorizontalAlignment="Right"/>
          <TextBox Grid.Row="1" Grid.Column="1" Height="55" VerticalScrollBarVisibility="Visible" TextWrapping="Wrap"
                   Text="{Binding SelectedItem.FCWConditionComments, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
      </GroupBox>
    </Grid>
  </Grid>
</local:NetrateFCWListView>