<PreprocessErrorViewerView x:Class="MgaSystems.Ims.Fortegra.PolicyImport.UI.PreprocessErrorViewer.PreprocessErrorViewerView"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                           FrameworkElement.Height="450" FrameworkElement.Width="800" Title="Preprocess Errors">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ListViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
        <Setter Property="FrameworkElement.Height" Value="20"/>
        <Style.Triggers>
          <Trigger Property="TextBoxBase.IsReadOnly" Value="true">
            <Setter Property="Control.Background" Value="LightGray"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style x:Key="SearchBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource standardTextForegroundColor}"/>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DataGrid Name="PreprocessErrorsGrid" Margin="0,2,0,2" CanUserAddRows="false" CanUserDeleteRows="false"
            IsSynchronizedWithCurrentItem="True" ColumnHeaderHeight="18" MaxWidth="800"
            ItemsSource="{Binding PolicyImportDataManager.ImportLogPreprocessErrorList, UpdateSourceTrigger=PropertyChanged}">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Import Log ID " Width="Auto" IsReadOnly="true"
                          Binding="{Binding ImportLogID, UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="Policy Number " Width="Auto" IsReadOnly="true"
                          Binding="{Binding PolicyNumber, UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="Control Number " Width="Auto" IsReadOnly="true"
                          Binding="{Binding ExistingPolicyControlNumber, UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="Error Message " Width="Auto" IsReadOnly="true"
                          Binding="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}">
        <DataGridColumn.CellStyle>
          <Style>
            <Setter Property="FrameworkElement.ToolTip" Value="{Binding ErrorMessage}"/>
          </Style>
        </DataGridColumn.CellStyle>
      </DataGridTextColumn>
    </DataGrid.Columns>
  </DataGrid>
</PreprocessErrorViewerView>