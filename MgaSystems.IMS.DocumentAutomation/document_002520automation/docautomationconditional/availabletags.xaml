<AvailableTags x:Class="MGASystems.IMS.DocumentAutomation.AvailableTags"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
               xmlns:baseWpfBehaviors="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
               xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
               x:Name="AvailableTags" FrameworkElement.Height="500" FrameworkElement.Width="500"
               Title="Available Tags" ResizeMode="CanResizeWithGrip">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/SharedResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ListViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource gridViewColumnHeaderStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style TargetType="{x:Type ListViewItem}">
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Control.Background" Value="White"/>
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Control.Background" Value="{StaticResource alternateRowBrush}"/>
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="true">
            <Trigger.Setters>
              <Setter Property="Control.Background" Value="{StaticResource selectedItemBrush}"/>
            </Trigger.Setters>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Filter Group:" Margin="2"/>
      <TextBox Grid.Row="0" Grid.Column="1" Margin="2"
               Text="{Binding FilterGroup, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter Tag Name:" Margin="2,0,2,0"/>
      <TextBox Grid.Row="1" Grid.Column="1" Margin="2,0,2,0"
               Text="{Binding FilterTagName, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Filter Tag Description:" Margin="2"/>
      <TextBox Grid.Row="2" Grid.Column="1" Margin="2"
               Text="{Binding FilterTagDescription, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
    <ListView Grid.Row="1" AlternationCount="2" AutoSizeGridViewColumnsOnItemsSourceChanged="true"
              ItemsSource="{Binding TagsCVS.View}" SelectedItem="{Binding SelectedItem}">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseDoubleClick">
          <i:InvokeCommandAction Command="{Binding OKCommand}" CommandParameter="{Binding ElementName=AvailableTags}"/>
        </i:EventTrigger>
      </i:Interaction.Triggers>
      <ItemsControl.GroupStyle>
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="{x:Type GroupItem}">
              <Setter Property="FrameworkElement.Margin" Value="0,2,0,2"/>
              <Setter Property="Control.Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Expander IsExpanded="false" Background="#FFF7F6F1" BorderBrush="DarkSlateGray" BorderThickness="0,0,0,1">
                      <HeaderedContentControl.Header>
                        <TextBlock FontWeight="Bold" Margin="5,0,0,0" Text="{Binding Path=Name}"/>
                      </HeaderedContentControl.Header>
                      <ContentControl.Content>
                        <ItemsPresenter/>
                      </ContentControl.Content>
                    </Expander>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </ItemsControl.GroupStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Tag Name" DisplayMemberBinding="{Binding TagName}"/>
          <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}"/>
        </GridView>
      </ListView.View>
    </ListView>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="OK" IsDefault="true" Margin="2" Command="{Binding OKCommand}"
              CommandParameter="{Binding ElementName=AvailableTags}"/>
      <Button Content="Cancel" IsCancel="true" Margin="0,2,2,2" Command="{Binding CancelCommand}"
              CommandParameter="{Binding ElementName=AvailableTags}"/>
    </StackPanel>
  </Grid>
</AvailableTags>