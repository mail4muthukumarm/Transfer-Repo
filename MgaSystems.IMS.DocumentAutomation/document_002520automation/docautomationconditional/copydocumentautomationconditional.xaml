<local:CopyDocumentAutomationConditional x:Class="MGASystems.IMS.DocumentAutomation.CopyDocumentAutomationConditional"
                                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                         xmlns:local="clr-namespace:MGASystems.IMS.DocumentAutomation"
                                         xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                                         x:Name="CopyConditional" FrameworkElement.Height="650" FrameworkElement.Width="700"
                                         Title="Copy Conditional" ResizeMode="CanResizeWithGrip"
                                         TransactionLogFilter="C264F669-5FD6-454A-B014-ED5A9F43B9B8"
                                         FrameworkElement.Cursor="{Binding UICursor, UpdateSourceTrigger=PropertyChanged}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/SharedResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style TargetType="{x:Type ListViewItem}">
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Control.Background" Value="White"/>
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Control.Background" Value="{StaticResource alternateRowBrush}"/>
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="true">
            <Trigger.Setters>
              <Setter Property="Control.Background" Value="{StaticResource selectedItemBrush}"/>
            </Trigger.Setters>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="Navy" BorderThickness="1" Margin="2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="System Event:" Margin="2"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding EventName}"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tag Name:" Margin="2"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="2"
                   Text="{Binding ConditionToCopy.TagName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Operator:" Margin="2"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="2"
                   Text="{Binding ConditionToCopy.CheckOperator, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Value:" Margin="2"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Margin="2"
                   Text="{Binding ConditionToCopy.CheckValue, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
    </Border>
    <Grid Row="1">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Text="Company Filter:" Margin="2"/>
        <ComboBox DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="2,0,2,2"
                  ItemsSource="{Binding CompanyLocationList, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValue="{Binding SelectedCompanyLocation, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1">
        <TextBlock Text="Line Filter:" Margin="2"/>
        <ComboBox DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="2,0,2,2"
                  ItemsSource="{Binding LineList, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValue="{Binding SelectedLine, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="2">
        <TextBlock Text="State Filter:" Margin="2"/>
        <ComboBox DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="2,0,2,2"
                  ItemsSource="{Binding StateList, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValue="{Binding SelectedState, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Grid.Column="1" TextAlignment="Center">
        <Hyperlink Command="{Binding ApplyFilterCommand}">
          <TextBlock Text="Apply Filter"/>
        </Hyperlink>
      </TextBlock>
    </Grid>
    <DataGrid Grid.Row="2" AutoGenerateColumns="false" HorizontalScrollBarVisibility="Visible"
              SelectionMode="Single" ItemsSource="{Binding CompanyLineList, UpdateSourceTrigger=PropertyChanged}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Company " Width="Auto" IsReadOnly="true"
                            Binding="{Binding CompanyLocationName, Mode=OneTime}"/>
        <DataGridTextColumn Header="Line  " Width="Auto" IsReadOnly="true" Binding="{Binding LineName, Mode=OneTime}"/>
        <DataGridTextColumn Header="State  " Width="Auto" IsReadOnly="true" Binding="{Binding StateName, Mode=OneTime}"/>
        <DataGridTemplateColumn Header="Existing Conditional  " Width="Auto" IsReadOnly="true">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsEnabled="false"
                        IsChecked="{Binding HasExistingConditional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Copy  " Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Copy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" TextAlignment="Left" Margin="5,0,30,0">
        <Hyperlink CommandParameter="true" Command="{Binding SelectUnselectItem}">
          <TextBlock Text="Check All"/>
        </Hyperlink>
      </TextBlock>
      <TextBlock Grid.Column="1" TextAlignment="Left">
        <Hyperlink CommandParameter="false" Command="{Binding SelectUnselectItem}">
          <TextBlock Text="Uncheck All"/>
        </Hyperlink>
      </TextBlock>
      <Button Grid.Column="2" Content="OK" Margin="2" Command="{Binding OKCommand}"
              CommandParameter="{Binding ElementName=CopyConditional}"/>
      <Button Grid.Column="3" Content="Cancel" Margin="0,2,2,2" Command="{Binding CancelCommand}"
              CommandParameter="{Binding ElementName=CopyConditional}"/>
    </Grid>
  </Grid>
</local:CopyDocumentAutomationConditional>