<local:QuoteStatusView x:Class="MgaSystems.IMS.TechTools.QuoteStatusAdmin.UI.QuoteStatusView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:local="clr-namespace:MgaSystems.IMS.TechTools.QuoteStatusAdmin.UI"
                       xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                       xmlns:baseWpfBehaviors="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                       x:Name="mainWindow" FrameworkElement.Height="750" FrameworkElement.Width="1000"
                       Title="Quote Status Admin" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
                       TransactionLogFilter="74C0E512-6D56-4A1F-8ADE-7CFE1E3479EB"
                       PromptOnCloseIfDataContextHasChanges="true">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ListViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
        <Setter Property="FrameworkElement.Height" Value="20"/>
        <Style.Triggers>
          <Trigger Property="TextBoxBase.IsReadOnly" Value="true">
            <Setter Property="Control.Background" Value="LightGray"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style x:Key="SearchBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource standardTextForegroundColor}"/>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel LastChildFill="true">
    <ToolBarTray DockPanel.Dock="Top">
      <FrameworkElement.Resources>
        <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource toolBarTrayStyle}"/>
        <Style TargetType="{x:Type Image}" BasedOn="{StaticResource verticalToolbarImageStyle}"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource toolbarButtonStyle}"/>
        <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource toolbarStackPanelStyle}"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource verticalToolbarTextBlockStyle}"/>
        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource verticalToolbarAccessTextStyle}"/>
      </FrameworkElement.Resources>
      <ToolBar>
        <Button ToolTip="Save" Command="{Binding SaveCommand}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/saveHS.png"/>
            <AccessText Text="_Save"/>
          </StackPanel>
        </Button>
        <Separator/>
        <baseWpfBehaviors:UndoButton ChangeManager="{Binding AuthorityManager.ChangeManager, Mode=OneWay}"/>
        <baseWpfBehaviors:RedoButton ChangeManager="{Binding AuthorityManager.ChangeManager, Mode=OneWay}"/>
        <Separator/>
        <Button ToolTip="Add Quote Status" Command="{Binding AddQuoteStatusCommand}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/add.png"/>
            <AccessText Text="Add Quote Status"/>
          </StackPanel>
        </Button>
        <Separator/>
      </ToolBar>
    </ToolBarTray>
    <Grid Row="0">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="auto"/>
      </Grid.RowDefinitions>
      <DataGrid Grid.Row="0" CanUserAddRows="false" CanUserDeleteRows="false" IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding QuoteStatusManager.QuoteStatusList, UpdateSourceTrigger=PropertyChanged}"
                SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Quote Status ID " Width="Auto" IsReadOnly="true"
                              Binding="{Binding QuoteStatusID, UpdateSourceTrigger=PropertyChanged}"/>
          <DataGridTextColumn Header="Description " Width="Auto" IsReadOnly="true"
                              Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Row="1" Margin="2" Padding="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Quote Status ID:"/>
            <TextBox IsReadOnly="true" Width="50" HorizontalAlignment="Left"
                     Text="{Binding SelectedItem.QuoteStatusID, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="Description:"/>
            <TextBox MaxLength="50" Text="{Binding SelectedItem.Description, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBlock Text="Event:"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
              </Grid.ColumnDefinitions>
              <TextBox IsReadOnly="true" Text="{Binding SelectedItem.EventName, UpdateSourceTrigger=PropertyChanged}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button VerticalAlignment="Bottom" IsDefault="true" Height="20" Width="20"
                        Style="{StaticResource SearchBtnStyle}" ToolTip="Find Event" Command="{Binding FindEventCommand}">
                  <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/magnifier.png"/>
                </Button>
                <Button VerticalAlignment="Bottom" IsDefault="true" Height="20" Width="20"
                        Style="{StaticResource SearchBtnStyle}" ToolTip="Clear Event" Command="{Binding ClearEventCommand}">
                  <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/deleteHS.png"/>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
          <Grid Row="3" Margin="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="auto"/>
              <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="0" Content="Bound"
                      IsChecked="{Binding SelectedItem.Bound, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Row="0" Grid.Column="1" Content="Reason Required"
                      IsChecked="{Binding SelectedItem.ReasonRequired, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Row="1" Grid.Column="0" Content="User Selectable"
                      IsChecked="{Binding SelectedItem.UserSelectable, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Row="1" Grid.Column="1" Content="Can Expire"
                      IsChecked="{Binding SelectedItem.CanExpire, UpdateSourceTrigger=PropertyChanged}"/>
          </Grid>
          <StackPanel Grid.Row="4">
            <TextBlock Text="Embedded Image Name:"/>
            <TextBox MaxLength="50" Text="{Binding SelectedItem.EmbeddedImageName, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <Grid Row="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Sort Order:"/>
              <TextBox MaxLength="50" Text="{Binding SelectedItem.SortOrder, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Automation Code:"/>
              <TextBox MaxLength="50" Text="{Binding SelectedItem.AutomationCode, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</local:QuoteStatusView>