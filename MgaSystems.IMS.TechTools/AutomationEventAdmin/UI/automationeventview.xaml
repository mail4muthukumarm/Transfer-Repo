<local:AutomationEventView x:Class="MgaSystems.IMS.TechTools.AutomationEventAdmin.UI.AutomationEventView"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:local="clr-namespace:MgaSystems.IMS.TechTools.AutomationEventAdmin.UI"
                           xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                           x:Name="mainWindow" FrameworkElement.Height="750" FrameworkElement.Width="1000"
                           Title="Automation Event Admin" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
                           PromptOnCloseIfDataContextHasChanges="true">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ListViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource standardTextForegroundColor}"/>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel LastChildFill="true">
    <ToolBarTray DockPanel.Dock="Top">
      <FrameworkElement.Resources>
        <Style TargetType="{x:Type ToolBarTray}" BasedOn="{StaticResource toolBarTrayStyle}"/>
        <Style TargetType="{x:Type Image}" BasedOn="{StaticResource verticalToolbarImageStyle}"/>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource toolbarButtonStyle}"/>
        <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource toolbarStackPanelStyle}"/>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource verticalToolbarTextBlockStyle}"/>
        <Style TargetType="{x:Type AccessText}" BasedOn="{StaticResource verticalToolbarAccessTextStyle}"/>
      </FrameworkElement.Resources>
      <ToolBar>
        <Button ToolTip="Save" Command="{Binding SaveCommand}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/saveHS.png"/>
            <AccessText Text="_Save"/>
          </StackPanel>
        </Button>
        <Separator/>
        <Button ToolTip="Add Automation Event" Command="{Binding AddAutomationEventCommand}">
          <StackPanel>
            <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/add.png"/>
            <AccessText Text="Add Automation Event"/>
          </StackPanel>
        </Button>
        <Separator/>
      </ToolBar>
    </ToolBarTray>
    <DockPanel LastChildFill="true">
      <DataGrid DockPanel.Dock="Left" CanUserAddRows="false" CanUserDeleteRows="false"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding AutomationEventManager.AutomationEventList, UpdateSourceTrigger=PropertyChanged}"
                SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Event Name " Width="Auto" IsReadOnly="true"
                              Binding="{Binding EventName, UpdateSourceTrigger=PropertyChanged}"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border DockPanel.Dock="Left" Margin="2" Padding="2" BorderBrush="Gray" BorderThickness="1"
              CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Event Name:"/>
          <TextBox Grid.Row="1" MaxLength="50"
                   Text="{Binding SelectedItem.EventName, UpdateSourceTrigger=PropertyChanged}"
                   IsReadOnly="{Binding SelectedItem.SystemDefined, UpdateSourceTrigger=PropertyChanged}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource textBoxStyleMain}">
                <Setter Property="FrameworkElement.Height" Value="20"/>
                <Style.Triggers>
                  <Trigger Property="TextBoxBase.IsReadOnly" Value="true">
                    <Setter Property="Control.Background" Value="LightGray"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBox>
          <StackPanel Grid.Row="2">
            <TextBlock Text="Document Automation Group ID:"/>
            <ComboBox DisplayMemberPath="TemplateGroup" SelectedValuePath="ID" MinWidth="50"
                      ItemsSource="{Binding AutomationEventManager.DocumentAutomationGroups}"
                      SelectedValue="{Binding SelectedItem.DocumentAutomationGroupID, UpdateSourceTrigger=PropertyChanged}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource comboBoxStyle}">
                  <Setter Property="UIElement.IsEnabled" Value="true"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedItem.SystemDefined, UpdateSourceTrigger=PropertyChanged}" Value="True">
                      <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ComboBox>
          </StackPanel>
          <Grid Row="3" Margin="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="auto"/>
              <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="0" Content="Send to Document Handler"
                      Style="{StaticResource checkBoxStyle}"
                      IsChecked="{Binding SelectedItem.SendToDocHandler, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Row="0" Grid.Column="1" Content="System Defined" IsEnabled="false"
                      Style="{StaticResource checkBoxStyle}"
                      IsChecked="{Binding SelectedItem.SystemDefined, UpdateSourceTrigger=PropertyChanged}"/>
          </Grid>
        </Grid>
      </Border>
    </DockPanel>
  </DockPanel>
</local:AutomationEventView>