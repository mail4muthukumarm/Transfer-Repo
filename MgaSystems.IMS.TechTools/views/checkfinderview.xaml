<CheckFinderView x:Class="MgaSystems.IMS.TechTools.Views.CheckFinderView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                 xmlns:controls="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                 xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                 xmlns:data="clr-namespace:MgaSystems.IMS.TechTools.ViewModels"
                 Loaded="MgaMdiChild_Loaded" ResizeMode="CanResizeWithGrip" FrameworkElement.Height="554"
                 FrameworkElement.Width="700" Title="Check Finder Tool">
  <BusyIndicator x:Name="BusyBar" IsBusy="{Binding IsBusy, Mode=TwoWay}">
    <Grid Margin="0,0,10,0">
      <Grid Margin="10,10,371,504">
        <Label Content="Check Date:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
        <controls:MgaDatePicker FrameworkElement.Name="DpDateFrom" FrameworkElement.HorizontalAlignment="Left"
                                FrameworkElement.Margin="83,0,0,0" FrameworkElement.VerticalAlignment="Center"
                                DatePicker.SelectedDate="{Binding DateFrom, Mode=TwoWay}"/>
        <Label Content="to" HorizontalAlignment="Left" Margin="185,0,0,0" VerticalAlignment="Center"/>
        <controls:MgaDatePicker FrameworkElement.Name="DpDateTo" FrameworkElement.HorizontalAlignment="Left"
                                FrameworkElement.Margin="207,0,0,0" FrameworkElement.VerticalAlignment="Center"
                                DatePicker.SelectedDate="{Binding DateTo, Mode=TwoWay}"/>
      </Grid>
      <Grid Margin="10,56,371,426">
        <Label Content="Check Type:" Margin="4,0,227,23"/>
        <CheckBox Name="ChbInvoice" Content="Invoice" HorizontalAlignment="Left" Margin="82,6,0,0"
                  VerticalAlignment="Top" IsChecked="{Binding IsInvoiceChecked, Mode=TwoWay}"/>
        <CheckBox Name="ChbClaims" Content="Claims" HorizontalAlignment="Left" Margin="82,27,0,0"
                  VerticalAlignment="Top" IsChecked="{Binding IsClaimsChecked, Mode=TwoWay}"/>
        <CheckBox Name="ChbOperating" Content="Operating" HorizontalAlignment="Left" Margin="82,47,0,0"
                  VerticalAlignment="Top" IsChecked="{Binding IsOperatingChecked, Mode=TwoWay}"/>
      </Grid>
      <Grid Margin="-41,127,340,393">
        <Label Content="Check Printer:" Margin="48,0,-48,0"/>
        <ComboBox Name="CboCheckPrinterSettings" DisplayMemberPath="PrinterFriendlyName"
                  SelectedValuePath="PrinterId" HorizontalAlignment="Left" Margin="134,0,0,0"
                  VerticalAlignment="Center" Width="186" ItemsSource="{Binding CheckPrinterSettings}"
                  SelectedValue="{Binding PrinterId}" Validation.ErrorTemplate="{x:Null}"/>
      </Grid>
      <Grid Margin="10,166,10,355">
        <Button x:Name="BGetChecks" Content="Get Checks" HorizontalAlignment="Left" Margin="10,0,0,0"
                VerticalAlignment="Center" Height="24" Width="109" Command="{Binding GetChecksCommand}"/>
        <Button Name="BConfigureAccountingPrinters" Content="Configure Accounting Printers"
                HorizontalAlignment="Left" VerticalAlignment="Center" Width="180" Margin="133,0,0,0" Height="24"
                Command="{Binding ConfigureAccountingPrintersCommand}"/>
      </Grid>
      <Grid Margin="10,205,10,10">
        <DataGrid Name="DgChecks" IsReadOnly="true" AutoGenerateColumns="false" Margin="10,0,0,10"
                  ItemsSource="{Binding Checks}">
          <FrameworkElement.Resources>
            <ContextMenu x:Key="CheckRowContextMenu">
              <ItemsControl.Items>
                <MenuItem Header="Reprint Check"
                          Command="{Binding DataContext.ReprintCheckCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                          CommandParameter="{Binding DataContext.TransactNum, RelativeSource={RelativeSource Mode=Self}}"/>
              </ItemsControl.Items>
            </ContextMenu>
          </FrameworkElement.Resources>
          <DataGrid.RowStyle>
            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource CheckRowContextMenu}"/>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Transaction #" Binding="{Binding TransactNum}"/>
            <DataGridTextColumn Header="Check #" Binding="{Binding CheckNum}"/>
            <DataGridTextColumn Header="Check Type" Binding="{Binding CheckType}"/>
            <DataGridTextColumn Header="Check Date" Binding="{Binding CheckDate}"/>
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}"/>
            <DataGridTextColumn Header="Payee" Binding="{Binding PayeeName}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </BusyIndicator>
</CheckFinderView>