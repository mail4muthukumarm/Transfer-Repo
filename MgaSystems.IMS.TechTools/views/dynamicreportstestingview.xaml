<local:DynamicReportsTestingView x:Class="MgaSystems.IMS.TechTools.Views.DynamicReportsTestingView"
                                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                 xmlns:local="clr-namespace:MgaSystems.IMS.TechTools.Views"
                                 xmlns:data="clr-namespace:MgaSystems.IMS.TechTools.ViewModels"
                                 xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                                 xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                                 ResizeMode="CanResizeWithGrip" FrameworkElement.Height="180" FrameworkElement.Width="700"
                                 Title="Dynamic Reports Test Tool">
  <FrameworkElement.Resources>
    <Style TargetType="{x:Type ComboBox}">
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="true">
          <Setter Property="FrameworkElement.ToolTip"
                  Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
        </Trigger>
      </Style.Triggers>
      <Setter Property="Grid.Column" Value="1"/>
      <Setter Property="FrameworkElement.Margin" Value="2"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="true">
          <Setter Property="FrameworkElement.ToolTip"
                  Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}"/>
        </Trigger>
      </Style.Triggers>
      <Setter Property="FrameworkElement.Margin" Value="2"/>
    </Style>
  </FrameworkElement.Resources>
  <BusyIndicator x:Name="BusyBar" IsBusy="{Binding IsBusy}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="50*"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="50*"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid Name="ContentGrid" Row="1" Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="75"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Label Content="Control Number:" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <TextBox Name="ControlID" Grid.Column="1" Height="20" Text="{Binding ControlID}"/>
          <Button Grid.Column="3" Grid.Row="1" IsEnabled="true" Height="25" Width="100" Content="Get Quote IDs..."
                  HorizontalAlignment="Center" Command="{Binding RunGetQuoteIDsCommand}"/>
          <Label Content="Quote ID:" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <ComboBox Name="cboQuoteIDs" Grid.Column="5" Grid.Row="1" Height="25" Width="80" HorizontalAlignment="Left"
                    DisplayMemberPath="QuoteId" SelectedValuePath="QuoteGuid" Text="{Binding QuoteID}"
                    ItemsSource="{Binding QuoteIDs}"/>
        </Grid>
        <Grid Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50*"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Label Content="Report:" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                 HorizontalAlignment="Right"/>
          <Grid Column="2" Row="1">
            <FrameworkElement.DataContext>
              <CollectionViewSource Filter="Reports_OnFilter" x:Name="reportsView" Source="{Binding Reports}"/>
            </FrameworkElement.DataContext>
            <ComboBox KeyUp="CboTests_OnKeyUp" Name="cboTests" Height="25" Width="350" DisplayMemberPath="TestName"
                      SelectedValuePath="Test" IsSynchronizedWithCurrentItem="False" IsEditable="true"
                      StaysOpenOnEdit="true" ItemsSource="{Binding}"/>
          </Grid>
          <Button Grid.Column="3" Grid.Row="1" Height="25" Width="100" Content="Run Selected..."
                  HorizontalAlignment="Center" Command="{Binding RunReportCommand}"
                  CommandParameter="{Binding SelectedItem, ElementName=cboTests}"/>
        </Grid>
      </Grid>
    </Grid>
  </BusyIndicator>
</local:DynamicReportsTestingView>