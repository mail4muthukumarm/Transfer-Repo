<local:CompanyLineInstallmentBillingTypeView x:Class="MGASystems.IMS.InsuredsProducersCompanies.CompanyLineInstallmentBillingTypeView"
                                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                             xmlns:local="clr-namespace:MGASystems.IMS.InsuredsProducersCompanies"
                                             xmlns:mgaInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                                             x:Name="mainWindow" FrameworkElement.Height="375" FrameworkElement.Width="775"
                                             Title="Assign Billing Types" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
                                             TransactionLogFilter="772E2583-4CDD-444B-9AB0-BBC5E93108B3">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/ToolBarResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/TreeViewResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
        <Setter Property="FrameworkElement.Margin" Value="2"/>
      </Style>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.Margin" Value="2"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource standardTextForegroundColor}"/>
      </Style>
      <DataTemplate x:Key="lbiTemplate">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Margin="2" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Column="1" Margin="0,2,2,2" Text="{Binding BillingType}"/>
        </Grid>
      </DataTemplate>
      <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentControl.ContentTemplate" Value="{StaticResource lbiTemplate}"/>
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Control.Background" Value="White"/>
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Control.Background" Value="{StaticResource alternateRowBrush}"/>
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="true">
            <Trigger.Setters>
              <Setter Property="Control.Background" Value="{StaticResource selectedItemBrush}"/>
            </Trigger.Setters>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <ListBox Grid.Row="0" AlternationCount="2" IsSynchronizedWithCurrentItem="True" Margin="2"
             ItemsSource="{Binding CodeManager.BillingTypeList}"/>
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Content="OK" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=mainWindow}"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}"
              CommandParameter="{Binding ElementName=mainWindow}"/>
    </StackPanel>
  </Grid>
</local:CompanyLineInstallmentBillingTypeView>