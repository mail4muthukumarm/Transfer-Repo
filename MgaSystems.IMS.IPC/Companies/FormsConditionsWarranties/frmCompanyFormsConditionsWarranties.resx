  <data name="SqlSelectCommand1.CommandText" xml:space="preserve">
    <value>SELECT     tblCompanyInterestForms.Company_FCW_ID, tblCompanyInterestForms.InterestType
FROM         tblCompanyInterestForms INNER JOIN
                      tblCompanyFormsConditionsWarranties ON 
                      tblCompanyInterestForms.Company_FCW_ID = tblCompanyFormsConditionsWarranties.Company_FCW_ID
WHERE     (tblCompanyFormsConditionsWarranties.CompanyLineID = @CLID)</value>
  </data>
