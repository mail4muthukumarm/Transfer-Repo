<local:ProcessImportView x:Class="MGASystems.IMS.Underwriting.Import_Inspection.ProcessImportView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:MGASystems.IMS.Underwriting.Import_Inspection"
                         xmlns:mgasystemsInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                         xmlns:mgaBehavior="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                         x:Name="mainWindow" FrameworkElement.Height="405" FrameworkElement.Width="525"
                         Title="Process Inspection Import" ResizeMode="CanResizeWithGrip">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style x:Key="tblImportMessgeStyle" TargetType="{x:Type TextBlock}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsError}" Value="True">
            <Setter Property="TextBlock.FontStyle" Value="Italic"/>
            <Setter Property="TextBlock.Foreground" Value="Red"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding HasInvalidData}" Value="True">
            <Setter Property="TextBlock.Foreground" Value="Blue"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ListBox Grid.Row="0" ScrollOnNewItem="true"
             ItemsSource="{Binding Messages, UpdateSourceTrigger=PropertyChanged}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Style="{StaticResource tblImportMessgeStyle}"
                     Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Margin="2" Text="{Binding ProcessingMsg}"/>
    <ProgressBar Grid.Row="2" Margin="2" Height="12" Maximum="{Binding Maximum}" Value="{Binding CurrentRow}"/>
    <Button Grid.Row="3" Content="Print to Text File" HorizontalAlignment="Right" Margin="2"
            Command="{Binding PrintToTextCommand}"/>
  </Grid>
</local:ProcessImportView>