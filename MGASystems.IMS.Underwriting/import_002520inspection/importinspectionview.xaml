<local:ImportInspectionView x:Class="MGASystems.IMS.Underwriting.Import_Inspection.ImportInspectionView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:local="clr-namespace:MGASystems.IMS.Underwriting.Import_Inspection"
                            xmlns:mgasystemsInterop="clr-namespace:Mga.Wpf.Ims.Interop;assembly=Mga.Wpf.Ims"
                            xmlns:baseWpfControls="clr-namespace:Mga.Wpf.Ims.Controls;assembly=Mga.Wpf.Ims"
                            x:Name="mainWindow" FrameworkElement.Height="705" FrameworkElement.Width="779"
                            Title="Import Inspection Information" ResizeMode="CanResizeWithGrip"
                            FrameworkElement.Cursor="{Binding UICursor, UpdateSourceTrigger=PropertyChanged}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/CommonResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/ListViewResources.xaml"/>
        <ResourceDictionary Source="/Mga.Wpf.Ims;component/Resources/DatagridResources2.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Mga.Wpf.Ims;component/Resources/SuggestTextBoxBaseResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource dataGridStyle}"/>
      <Style TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="80"/>
      </Style>
      <Style x:Key="SearchButton" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.MinWidth" Value="16"/>
      </Style>
      <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FrameworkElement.MinWidth" Value="100"/>
      </Style>
      <Style TargetType="{x:Type baseWpfControls:SuggestTextBoxIS}" BasedOn="{StaticResource SuggestISStyle}">
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Grid.Row" Value="1"/>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Policy #:" Margin="2"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" IsReadOnly="true" MinWidth="100"
                 Text="{Binding InspectionMapping.PolicyNumberColumn, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=true}"/>
        <Button Grid.Column="1" Margin="2" Style="{StaticResource SearchButton}"
                Command="{Binding GetPolicyNoColumnCommand}" CommandParameter="{Binding}">
          <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/magnifier.png" Height="16" Width="16"/>
        </Button>
      </Grid>
    </StackPanel>
    <DataGrid Grid.Row="1" CanUserSortColumns="true" AutoGenerateColumns="false"
              ItemsSource="{Binding ListCVS.View}" SelectedItem="{Binding SelectedItem}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="IMS Column " Width="Auto" IsReadOnly="true" Binding="{Binding IMS, Mode=OneTime}"/>
        <DataGridTemplateColumn Header="Spreadsheet Column ">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" IsReadOnly="true" MinWidth="100" Text="{Binding Spreadsheet}"/>
                <Button Grid.Column="1" Margin="2" Style="{StaticResource SearchButton}"
                        Command="{Binding DataContext.GetSpreadsheetColumnCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                        CommandParameter="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}">
                  <Image Source="pack://application:,,,/Mga.Wpf.Ims;component/Images/magnifier.png" Height="16" Width="16"/>
                </Button>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Button Content="Load Spreadsheet" Grid.Column="0" Margin="2" Command="{Binding LoadSpreadsheetCommand}"
              CommandParameter="{Binding}"/>
      <Button Content="Match Columns" Grid.Column="1" Margin="0,2,2,2" Command="{Binding MatchColumnsCommand}"
              CommandParameter="{Binding}"/>
      <Button Content="Load Saved Mappings" Grid.Column="2" Margin="0,2,2,2"
              Command="{Binding LoadMappingCommand}" CommandParameter="{Binding}"/>
      <Button Content="Save Mappings" Grid.Column="3" Margin="0,2,2,2" Command="{Binding SaveMappingCommand}"
              CommandParameter="{Binding}"/>
      <Button Content="Import Inspections" Grid.Column="4" Margin="0,2,2,2" Command="{Binding ImportCommand}"
              CommandParameter="{Binding}"/>
    </Grid>
  </Grid>
</local:ImportInspectionView>